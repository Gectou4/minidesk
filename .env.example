# MiniDesk — Variables d'environnement
# Copiez ce fichier en .env et renseignez les valeurs avant de lancer la stack.
# Les mots de passe ne sont pas ici, ils sont dans secrets/*.txt (Docker secrets).

# Application (PHP)
DB_HOST=db

# MySQL (noms imposés par l'image mysql, réutilisés par l'application)
# Ce sont des chemins vers les secrets, pas les mots de passe
MYSQL_DATABASE=minidesk
MYSQL_USER=minidesk_user
MYSQL_PASSWORD_FILE=/run/secrets/db_password
MYSQL_ROOT_PASSWORD_FILE=/run/secrets/db_root_password

# Application
APP_ENV=production
